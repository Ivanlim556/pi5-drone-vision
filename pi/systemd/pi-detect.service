[Unit]
Description=On-Pi object detection -> http://pi5drone.local:8889/detect
After=mediamtx.service
Requires=mediamtx.service

[Service]
User=pi
WorkingDirectory=/home/pi/detect
ExecStart=/home/pi/detect/.venv/bin/python /home/pi/detect/pi_detect.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
